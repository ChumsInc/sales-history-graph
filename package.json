{
  "name": "sales-history-graph",
  "version": "2.0.0",
  "private": true,
  "description": "Sales History Graph for Chums intranet dashboard",
  "homepage": "https://github.com/ChumsInc/sales-history-graph#readme",
  "bugs": {
    "url": "https://github.com/ChumsInc/sales-history-graph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChumsInc/sales-history-graph.git"
  },
  "author": "Steve Montgomery",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build-ssr": "vite build --ssr",
    "lint": "eslint .",
    "preview": "vite preview",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "dependencies": {
    "@chumsinc/ui-utils": "^2.0.4",
    "@observablehq/plot": "^0.6.17",
    "classnames": "^2.3.2",
    "dayjs": "^1.11.10",
    "numeral": "^2.0.6",
    "react": "^19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "auto-changelog": "^2.4.0",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "chums-types": "github:ChumsInc/chums-types",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.7"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "auto-changelog": {
    "template": "changelog-template.hbs",
    "unreleased": true,
    "commitLimit": false,
    "breakingPattern": "BREAKING CHANGE:"
  }
}
